{
  "name": "tmr-chain",
  "version": "1.0.0",
  "description": "TMR Chain: Next-Generation Layer-1 Hybrid Consensus Blockchain",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "mine": "node src/miner.js",
    "test": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "docs": "jsdoc -c jsdoc.json",
    "docker:build": "docker build -t tmr-chain:latest .",
    "docker:run": "docker run -d -p 8545:8545 -p 3000:3000 -p 4001:4001 -v tmr-data:/app/data --name tmr-node tmr-chain:latest",
    "docker:stop": "docker stop tmr-node && docker rm tmr-node",
    "docker:logs": "docker logs -f tmr-node",
    "cluster": "node scripts/run-cluster.js",
    "generate:keypair": "node scripts/generate-keypair.js",
    "validate:config": "node scripts/validate-config.js",
    "migrate:up": "node scripts/migrations/up.js",
    "migrate:down": "node scripts/migrations/down.js"
  },
  "keywords": [
    "blockchain",
    "crypto",
    "cryptocurrency",
    "ethereum",
    "smart-contracts",
    "proof-of-work",
    "proof-of-stake",
    "hybrid-consensus",
    "layer-1",
    "distributed-ledger"
  ],
  "author": "TMR Chain Team",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "dependencies": {
    "web3": "^1.10.0",
    "ethers": "^6.0.0",
    "express": "^4.18.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "level": "^8.0.0",
    "leveldown": "^6.1.0",
    "keccak": "^3.0.0",
    "secp256k1": "^4.0.0",
    "bip39": "^3.1.0",
    "bip32": "^4.0.0",
    "crypto-browserify": "^3.12.0",
    "bs58": "^5.0.0",
    "uuid": "^9.0.0",
    "winston": "^3.8.0",
    "pino": "^8.0.0",
    "joi": "^17.0.0",
    "axios": "^1.0.0",
    "ws": "^8.0.0",
    "rlp": "^3.0.0",
    "merkle-tree": "^1.0.0",
    "bn.js": "^5.2.0",
    "elliptic": "^6.5.4",
    "hash.js": "^1.1.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "jsdoc": "^4.0.0",
    "supertest": "^6.0.0",
    "sinon": "^15.0.0",
    "chai": "^4.0.0",
    "mocha": "^10.0.0"
  },
  "optionalDependencies": {
    "bcrypt": "^5.0.0",
    "sodium-native": "^3.0.0"
  },
  "nodemonConfig": {
    "watch": [
      "src/"
    ],
    "ignore": [
      "src/**/*.test.js",
      "data/",
      "logs/"
    ],
    "delay": 1000,
    "env": {
      "NODE_ENV": "development"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "!src/index.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ]
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2020": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2020,
      "sourceType": "module"
    },
    "rules": {
      "no-console": "off",
      "no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_"
        }
      ]
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tmr-chain/tmr-chain.git"
  },
  "bugs": {
    "url": "https://github.com/tmr-chain/tmr-chain/issues"
  },
  "homepage": "https://tmr-chain.io",
  "funding": {
    "type": "individual",
    "url": "https://tmr-chain.io/donate"
  }
}
